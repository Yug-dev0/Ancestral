  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yug-dev0/Ancestral.git",
    "directory": "packages/realtime"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
